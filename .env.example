POSTGRES_DB=flashflow
POSTGRES_USER=flashflow
POSTGRES_PASSWORD=flashflow
DATABASE_URL=postgresql+asyncpg://flashflow:flashflow@postgres:5432/flashflow
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INVENTORY_TOPIC=inventory-events
KAFKA_INVENTORY_PARTITIONS=6
# New topics use broker append timestamps. Existing topics require an explicit config alteration.
KAFKA_TIMESTAMP_TYPE=LogAppendTime
KAFKA_CONSUMER_GROUP=flashflow-inventory
KAFKA_DLQ_TOPIC=inventory-events-dlq
KAFKA_PRICING_TOPIC=pricing-events
PRICING_ENABLED=true
PRICING_WINDOW_SECONDS=30
PRICING_COOLDOWN_SECONDS=30
PRICING_REVERSAL_SECONDS=120
PRICING_MIN_PRICE=0.01
PRICING_MAX_PRICE=99999999.99
PRICING_MAX_INCREASE=0.20
PRICING_MAX_DISCOUNT=0.20
PRICING_MAX_STEP=0.05
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_SECONDS=0.5
WEBSOCKET_HEARTBEAT_SECONDS=15
SIMULATOR_MODE=NORMAL
SIMULATOR_EVENTS_PER_SECOND=10
SIMULATOR_PRODUCT_COUNT=100
SIMULATOR_BURST_DURATION_SECONDS=0
SIMULATOR_RANDOM_SEED=42
SIMULATOR_EVENT_MIX=STOCK_RESERVED:45,PURCHASE_COMPLETED:25,STOCK_RELEASED:20,INVENTORY_RESTOCKED:10
APP_ENV=production
ENABLE_CHAOS=false
CHAOS_TOKEN=
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_SECONDS=5
BREAKER_HALF_OPEN_TRIALS=1
INVENTORY_TIMEOUT_SECONDS=2

CONSUMER_INSTANCES=1
CONSUMER_BATCH_ENABLED=true
CONSUMER_BATCH_SIZE=50
CONSUMER_POLL_MS=50
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
WEBSOCKET_QUEUE_SIZE=100
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30
LOGGING_LEVEL=INFO
# Optional build-time frontend URL; blank uses the local :8000 socket.
NEXT_PUBLIC_WEBSOCKET_URL=
## Advisory retail demo / forecasts. Core inventory does not depend on these.
ENABLE_RETAIL_CONTROLS=false
FORECAST_BUCKET_SECONDS=5
FORECAST_INTERVAL_SECONDS=5
FORECAST_STALE_SECONDS=30
FORECAST_SAFETY_STOCK=10
FORECAST_MAX_RESTOCK=500
FORECAST_MODEL_PATH=/app/artifacts/demand-model.json
ANALYST_BASE_URL=https://api.openai.com/v1
ANALYST_MODEL=
ANALYST_API_KEY=
ANALYST_ENABLED=false

# Suppress unchanged replenishment advice; audit records remain immutable.
RECOMMENDATION_COOLDOWN_SECONDS=120
RECOMMENDATION_MIN_CHANGE_UNITS=5
RECOMMENDATION_CHANGE_FRACTION=0.25
